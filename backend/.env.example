# Copy to .env. Keep environment-specific values in this file or deployment secrets.
# Do not commit .env or reuse development credentials in production.

# API listener and the one public origin used when returning absolute links.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000

# One PostgreSQL database for every backend module.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energy_hub
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_SSL=false
# Optional custom CA PEM; use \n for line breaks. System trust roots are used when omitted.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Public files are served under /uploads; private files are never statically served.
# Use persistent mounted directories for live deployments.
UPLOADS_DIR=./uploads/energy_service
PRIVATE_UPLOADS_DIR=./private-uploads/energy_service

# Energy Provider and legacy Superadmin authentication.
JWT_SECRET=replace_with_a_unique_random_secret_of_32_characters_or_more
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_TTL_MS=600000
CORS_ORIGIN=http://localhost:3000

# Service Admin authentication and OTP configuration.
ACCESS_TOKEN_SECRET=replace_with_a_different_random_secret_of_32_characters_or_more
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
OTP_HASH_SECRET=
SMS_PROVIDER=dev
ENABLE_DEV_MAILBOX=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# Initial Superadmin account; set a unique password before first startup.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=
# Optional one-time import path for an existing legacy JSON state file.
# SUPERADMIN_DATA_FILE=./data/superadmin-access-control.json

# Optional production email settings (SMTP_HOST is required in production).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Optional Energy Provider SMS gateway for real OTP delivery.
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
# SMS_SENDER_ID=

# Required when SMS_PROVIDER=twilio in production.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
